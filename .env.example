# Optional. Without it, story generation falls back to a deterministic mock
# so the whole pipeline still runs end-to-end offline.
ANTHROPIC_API_KEY=

# Model used for story writing when a key is present.
HN_MODEL=claude-sonnet-4-6

# Optional. Only needed if you enable the X/Twitter source adapter.
# X_BEARER_TOKEN=

# Port for the feed server.
PORT=4400
