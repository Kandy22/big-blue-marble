{
  "name": "huggingnews-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI-curated, day-grouped news feed. A from-scratch clone of the HuggingNews architecture: ingest -> cluster -> generate -> serve.",
  "scripts": {
    "pipeline": "tsx src/pipeline/run.ts",
    "serve": "tsx src/server.ts",
    "dev": "tsx src/pipeline/run.ts && tsx src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "dotenv": "^17.4.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.7.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
